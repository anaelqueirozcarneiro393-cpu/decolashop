# ==========================================
# DECOLASHOP SAAS - CONFIGURAÇÃO DE AMBIENTE
# Preencha com suas próprias credenciais
# ==========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=sua-chave-secreta-de-sessao-aqui

# IA (Opcional para geração de copies)
GROQ_API_KEY=
GEMINI_API_KEY=

# SigiloPay Gateway API (app.sigilopay.com.br)
SIGILOPAY_PUBLIC_KEY=sua_chave_publica_aqui
SIGILOPAY_SECRET_KEY=sua_chave_privada_aqui
SIGILOPAY_BASE_URL=https://app.sigilopay.com.br
